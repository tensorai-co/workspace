{
  "name": "@tensorai-workspace/markdown",
  "version": "0.1.0",
  "description": "A Markdown preview that follows its source as it changes and as it scrolls, with images and links from the file system.",
  "license": "MIT",
  "homepage": "https://github.com/tensorai-co/workspace/tree/main/packages/markdown#readme",
  "bugs": {
    "url": "https://github.com/tensorai-co/workspace/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tensorai-co/workspace.git",
    "directory": "packages/markdown"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tensorai-workspace/markdown-parser": "0.1.0",
    "@tensorai-workspace/host": "0.1.0",
    "@tensorai-workspace/languages": "0.1.0",
    "@tensorai-workspace/text": "0.1.0",
    "@tensorai-workspace/theme": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
