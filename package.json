{
  "name": "workspace",
  "private": true,
  "description": "A browser IDE as React packages: editor, file explorer, tabs, split panes, terminal and Markdown preview.",
  "license": "MIT",
  "homepage": "https://github.com/tensorai-co/workspace#readme",
  "bugs": {
    "url": "https://github.com/tensorai-co/workspace/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tensorai-co/workspace.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "playground": "npm run dev -w @tensorai-workspace/playground",
    "playground:shell": "npm run dev:shell -w @tensorai-workspace/playground"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
